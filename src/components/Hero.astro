---
import { hero, site } from '../data/site';
---

<section class="hero" id="top">
  <div class="container">
    <div class="hero-eyebrow">
      <span class="eyebrow">{hero.eyebrow}</span>
      <span class="status">{hero.statusLabel}</span>
    </div>

    <h1 class="hero-title">
      {hero.titleLead}<span class="accent">{hero.titleAccent}</span>.
    </h1>

    <p class="hero-lead">{hero.lead}</p>

    <div class="hero-actions">
      <a class="btn btn-primary" href="#proyectos">Ver proyectos →</a>
      {site.cv && (
        <a class="btn btn-secondary" href={site.cv} download>Descargar CV</a>
      )}
    </div>

    <div class="hero-foot">
      <span>{site.location}</span>
      <span>{hero.scope}</span>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-16) var(--space-16);
  }

  @media (min-width: 768px) {
    .hero {
      padding-block: var(--space-24) var(--space-16);
    }
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }

  .hero-title {
    font-size: clamp(2.75rem, 9vw, 5.5rem);
    line-height: 0.95;
    max-width: 16ch;
  }

  .hero-lead {
    margin-top: var(--space-6);
    max-width: 58ch;
    font-size: 1.1875rem;
    line-height: 1.58;
    color: var(--ink-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .hero-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-16);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }
</style>

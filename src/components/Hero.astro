---
import { hero, site } from '../data/site';
import CtaButton from './CtaButton.astro';
---

<section class="hero" id="top">
  <div class="hero-stage">
    <div class="container hero-content">
      <div class="hero-meta">
        <span class="hero-eyebrow">{hero.eyebrow}</span>
        <span class="hero-status">{hero.statusLabel}</span>
      </div>
      <h1 class="hero-title">
        {hero.titleLead}<span class="accent">{hero.titleAccent}</span>.
      </h1>
      <span class="hero-badge" aria-hidden="true">
        <img src="/ac-badge.svg" alt="" width="76" height="76" />
      </span>
    </div>
  </div>

  <div class="container hero-below">
    <p class="hero-lead">{hero.lead}</p>
    <div class="hero-actions">
      <CtaButton label="Ver proyectos →" href="#proyectos" />
      <a class="hero-cv" href={site.cv || '#contacto'} {...site.cv ? { download: true } : {}}>
        Descargar CV
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
  }

  /* Escenario oscuro a pantalla completa, con fade al fondo de la pagina */
  .hero-stage {
    min-height: 84vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-block: var(--space-16) var(--space-24);
    --hero-veil: 46, 42, 36;
    --hero-text: #f4efe4;
    --hero-accent: #d6a9a2;
    --hero-eyebrow: #b9ab93;
    --hero-status: #9fd0bb;
    --hero-dot: #7cc2a9;
    color: var(--hero-text);
    background-color: var(--surface);
    position: relative;
    isolation: isolate;
  }

  /* En claro, velo claro (Nube) y texto oscuro: se funde con la pagina sin linea */
  :global(:root[data-theme='light']) .hero-stage {
    --hero-veil: 230, 220, 198;
    --hero-text: #2e2a24;
    --hero-accent: #6e4a4f;
    --hero-eyebrow: #7a6656;
    --hero-status: #2e6a57;
    --hero-dot: #2e6a57;
  }

  .hero-stage::before,
  .hero-stage::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  /* Textura botanica, difuminada hacia abajo con mascara */
  .hero-stage::before {
    background: url('/hero/botanica.jpg') center / cover no-repeat;
    opacity: 0.42;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 42%, transparent 86%);
    mask-image: linear-gradient(180deg, #000 0%, #000 42%, transparent 86%);
  }
  /* Velo Tinta que se desvanece al fondo de la pagina (sin corte) */
  .hero-stage::after {
    background: linear-gradient(
      180deg,
      rgba(var(--hero-veil), 0.88) 0%,
      rgba(var(--hero-veil), 0.84) 45%,
      rgba(var(--hero-veil), 0.4) 72%,
      rgba(var(--hero-veil), 0) 92%
    );
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-meta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: var(--space-6);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .hero-eyebrow {
    color: var(--hero-eyebrow);
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--hero-status);
  }
  .hero-status::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--hero-dot);
  }

  .hero-title {
    font-size: clamp(2.5rem, 7vw, 4.75rem);
    line-height: 1.04;
    max-width: 16ch;
    margin-inline: auto;
    color: var(--hero-text);
  }

  .hero-title .accent {
    font-weight: 600;
    color: var(--hero-accent);
  }

  .hero-badge {
    display: inline-flex;
    width: 76px;
    height: 76px;
    margin-top: var(--space-10, 2.5rem);
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
  }
  .hero-badge img {
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero-below {
    text-align: center;
    padding-bottom: var(--space-16);
  }

  .hero-lead {
    margin: 0 auto;
    max-width: 56ch;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .hero-cv {
    display: inline-flex;
    align-items: center;
    padding: 13px var(--space-6);
    border: 1px solid var(--line-strong);
    border-radius: 16px;
    background-color: var(--surface-raised);
    color: var(--ink);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.9375rem;
    line-height: 1;
    text-decoration: none;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .hero-cv:hover {
    border-color: var(--plume);
    color: var(--plume);
  }
</style>

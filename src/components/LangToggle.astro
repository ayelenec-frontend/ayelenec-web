---
// Selector de idioma ES/EN: es un enlace real a la pagina equivalente en el otro idioma
// (rastreable, funciona sin JavaScript). Reusa la animacion de deslizar del ThemeToggle,
// pero con texto (sin banderas): el thumb resalta el idioma activo.
import { altPath, getLang } from '../i18n';

const lang = getLang(Astro.url);
const isEn = lang === 'en';
const href = altPath(Astro.url.pathname);
---

<a
  class:list={['lang-switch', { 'is-en': isEn }]}
  href={href}
  hreflang={isEn ? 'es' : 'en'}
  aria-label={isEn ? 'Cambiar a español (Spanish)' : 'Switch to English (inglés)'}
  data-lang-toggle
>
  <span class="lang-track">
    <span class="lang-opt lang-opt--es">ES</span>
    <span class="lang-opt lang-opt--en">EN</span>
    <span class="lang-thumb" aria-hidden="true"></span>
  </span>
</a>

<style>
  .lang-switch {
    position: relative;
    display: inline-flex;
    align-items: center;
    width: 64px;
    height: 30px;
    padding: 0;
    border: 0;
    text-decoration: none;
    border-radius: var(--radius-pill);
    background-color: var(--surface-sunken);
    cursor: pointer;
    flex-shrink: 0;
    vertical-align: middle;
  }

  .lang-track {
    position: relative;
    display: flex;
    width: 100%;
    height: 100%;
  }

  .lang-thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: calc(50% - 3px);
    height: calc(100% - 6px);
    border-radius: var(--radius-pill);
    background-color: var(--plume);
    transition: transform 0.4s var(--ease);
    z-index: 0;
  }

  .lang-opt {
    position: relative;
    z-index: 1;
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    transition: color 0.4s var(--ease);
  }

  /* ES activo por defecto */
  .lang-opt--es {
    color: var(--on-plume);
  }

  .lang-switch.is-en .lang-thumb {
    transform: translateX(100%);
  }
  .lang-switch.is-en .lang-opt--es {
    color: var(--ink-muted);
  }
  .lang-switch.is-en .lang-opt--en {
    color: var(--on-plume);
  }

  .lang-switch:focus-visible {
    outline: 2px solid var(--plume);
    outline-offset: 2px;
  }
</style>

<script>
  // Mantiene la seccion en la que estabas al cambiar de idioma (#servicios, etc.).
  const link = document.querySelector<HTMLAnchorElement>('[data-lang-toggle]');
  link?.addEventListener('click', () => {
    if (window.location.hash) link.href = link.getAttribute('href') + window.location.hash;
  });
</script>

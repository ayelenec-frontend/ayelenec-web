---
// Carrusel "coverflow" de proyectos: la tarjeta activa al centro, grande, y
// las vecinas mas chicas asomando a los costados. Cada tarjeta lleva info
// breve + herramientas y un boton "Ver proyecto" que linkea a /proyectos/[slug].
import { projects } from '../data/projects';
import { getLang, t } from '../i18n';

const lang = getLang(Astro.url);
const s = t[lang].projects;
const prefix = lang === 'en' ? '/en' : '';
---

<section class="section" id="proyectos">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{s.eyebrow}</span>
      <h2>{s.head}</h2>
    </div>

    <div
      class="pc"
      data-carousel
      role="group"
      aria-roledescription="carrusel"
      aria-label="Proyectos seleccionados"
      tabindex="0"
    >
      <div class="pc-stage">
        <ul class="pc-track">
          {
            projects.map((project, i) => (
              <li class="pcard" data-index={i}>
                <article class="pcard-inner">
                  <div class={`pcard-media ${i % 2 === 0 ? 'media--night' : 'media--linen'}`}>
                    {project.image ? (
                      <img
                        src={project.image}
                        alt={`${project.client} — ${project.title[lang]}`}
                        loading="lazy"
                        width="800"
                        height="600"
                      />
                    ) : (
                      <span class="media-label">{project.client}</span>
                    )}
                    <span class="pcard-tag">{project.discipline}</span>
                  </div>

                  <div class="pcard-body">
                    <h3 class="pcard-title">{project.title[lang]}</h3>
                    <p class="pcard-desc">{project.description[lang]}</p>

                    <ul class="pcard-tools">
                      {project.tools.slice(0, 3).map((tool) => (
                        <li class="chip">{tool}</li>
                      ))}
                    </ul>

                    <a class="pc-btn" href={`${prefix}/proyectos/${project.slug}`}>
                      {s.cta}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path
                          d="M5 12h14M13 6l6 6-6 6"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </a>
                  </div>
                </article>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="pc-controls">
        <button class="pc-nav pc-nav--prev" type="button" aria-label="Proyecto anterior">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <div class="pc-dots" role="tablist" aria-label="Elegir proyecto">
          {
            projects.map((project, i) => (
              <button
                class="pc-dot"
                type="button"
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-label={`Ir a ${project.client}`}
                data-dot={i}
              />
            ))
          }
        </div>

        <button class="pc-nav pc-nav--next" type="button" aria-label="Proyecto siguiente">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .section-head {
    text-align: center;
    align-items: center;
    margin-inline: auto;
  }

  .pc {
    --pc-w: clamp(264px, 74vw, 348px);
    margin-top: var(--space-10, 2.5rem);
    outline: none;
  }

  .pc-stage {
    position: relative;
    width: 100%;
    height: 460px;
    transition: height 0.3s var(--ease);
  }

  .pc-track {
    position: relative;
    height: 100%;
  }

  .pcard {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--pc-w);
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: transform 0.5s cubic-bezier(0.33, 0.1, 0.25, 1), opacity 0.5s var(--ease);
    will-change: transform, opacity;
  }

  .pcard-inner {
    display: flex;
    flex-direction: column;
    background-color: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    transition: box-shadow 0.3s var(--ease);
  }

  .pcard.is-active .pcard-inner {
  }

  /* Las tarjetas no activas: no navegan al click del boton, se activan al tocarlas */
  .pcard:not(.is-active) {
    cursor: pointer;
  }
  .pcard:not(.is-active) .pc-btn {
    pointer-events: none;
  }

  .pcard-media {
    position: relative;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--line);
  }

  .pcard-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media--night {
    background-color: var(--brand-night);
  }
  .media--linen {
    background-color: var(--brand-linen);
  }

  .media-label {
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    padding: var(--space-4);
    text-align: center;
  }
  .media--night .media-label {
    color: #f7f9ec;
  }
  .media--linen .media-label {
    color: #17131b;
  }

  .pcard-tag {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    padding: 4px 10px;
    border-radius: 999px;
    background-color: var(--surface-raised);
    border: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .pcard-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
  }

  .pcard-title {
    font-size: 1.1875rem;
    line-height: 1.25;
    min-height: 2.5em;
  }

  .pcard-desc {
    color: var(--text-body);
    font-size: 0.9rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 4.05em;
  }

  .pcard-tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  .pc-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    align-self: flex-start;
    margin-top: var(--space-4);
    padding: 11px 20px;
    border: 1px solid var(--plume);
    border-radius: 12px;
    background-color: var(--plume);
    color: var(--on-plume);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.875rem;
    line-height: 1;
    text-decoration: none;
    transition: background-color 0.2s var(--ease), border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .pc-btn:hover {
    background-color: var(--plume-deep);
    border-color: var(--plume-deep);
    transform: translateX(2px);
  }
  .pc-btn svg {
    transition: transform 0.2s var(--ease);
  }
  .pc-btn:hover svg {
    transform: translateX(2px);
  }

  /* ---- Controles ---- */
  .pc-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .pc-nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background-color: var(--surface-raised);
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease), opacity 0.2s var(--ease);
  }
  .pc-nav:hover:not(:disabled) {
    background-color: var(--plume);
    border-color: var(--plume);
    color: var(--on-plume);
  }
  .pc-nav:disabled {
    color: var(--line-strong);
    border-color: var(--line);
    cursor: default;
  }

  .pc-dots {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .pc-dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border-radius: 50%;
    border: 0;
    background-color: var(--line-strong);
    cursor: pointer;
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease), background-color 0.2s var(--ease);
  }
  .pc-dot:hover {
    background-color: var(--ink-muted);
  }
  .pc-dot[aria-selected='true'] {
    background-color: var(--plume);
    transform: scale(1.3);
  }

  @media (prefers-reduced-motion: reduce) {
    .pcard,
    .pc-stage,
    .pc-btn,
    .pc-btn svg {
      transition: none;
    }
  }
</style>

<script>
  function initCarousel(root: HTMLElement) {
    const stage = root.querySelector<HTMLElement>('.pc-stage');
    const cards = Array.from(root.querySelectorAll<HTMLElement>('.pcard'));
    const prev = root.querySelector<HTMLButtonElement>('.pc-nav--prev');
    const next = root.querySelector<HTMLButtonElement>('.pc-nav--next');
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.pc-dot'));
    if (!stage || cards.length === 0) return;

    let active = 0;
    const n = cards.length;

    function layout() {
      const w = cards[0].offsetWidth;
      const gap = w * 0.42;
      cards.forEach((card, i) => {
        let off = i - active;
        if (off > n / 2) off -= n;
        if (off < -n / 2) off += n;
        const abs = Math.abs(off);
        const scale = abs === 0 ? 1 : abs === 1 ? 0.86 : 0.72;
        card.style.transform = `translate(-50%, -50%) translateX(${off * gap}px) scale(${scale})`;
        card.style.opacity = abs === 0 ? '1' : abs <= 2 ? '1' : '0';
        card.style.zIndex = String(50 - abs);
        card.style.pointerEvents = abs <= 2 ? 'auto' : 'none';
        card.classList.toggle('is-active', off === 0);
        card.setAttribute('aria-hidden', off === 0 ? 'false' : 'true');
      });
      stage.style.height = cards[active].offsetHeight + 'px';
      dots.forEach((d, i) => d.setAttribute('aria-selected', i === active ? 'true' : 'false'));
    }

    function go(i: number) {
      active = ((i % n) + n) % n;
      layout();
    }

    prev?.addEventListener('click', () => go(active - 1));
    next?.addEventListener('click', () => go(active + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    cards.forEach((card, i) =>
      card.addEventListener('click', (e) => {
        if (i !== active) {
          e.preventDefault();
          go(i);
        }
      })
    );
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        go(active - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        go(active + 1);
      }
    });

    let sx = 0;
    root.addEventListener('touchstart', (e) => (sx = e.touches[0].clientX), { passive: true });
    root.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - sx;
      if (Math.abs(dx) > 40) go(active + (dx < 0 ? 1 : -1));
    });

    window.addEventListener('resize', layout);
    window.addEventListener('load', layout);
    layout();
  }

  document
    .querySelectorAll<HTMLElement>('[data-carousel]')
    .forEach((el) => initCarousel(el));
</script>

---
// Fila imagen-texto dentro de la columna del articulo: foto con esquinas
// redondeadas a un lado y texto (titulo + parrafos) al otro. `reverse` alterna
// el lado de la foto. En celular la foto va arriba.
// Uso: <Row image="/x.jpg" alt="..." reverse>
//        ## Titulo
//        Texto...
//      </Row>
// Sin `image`, el lado visual toma el slot "media" (por ejemplo un <Graphic />).
interface Props {
  image?: string;
  alt?: string;
  reverse?: boolean;
}
const { image, alt = '', reverse = false } = Astro.props;
---

<section class:list={['row', { 'row--reverse': reverse }]}>
  <div class:list={['row-media', { 'row-media--graphic': !image }]}>
    {image ? <img src={image} alt={alt} loading="lazy" /> : <slot name="media" />}
  </div>
  <div class="row-text">
    <slot />
  </div>
</section>

<style>
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    align-items: center;
    margin-block: var(--space-12);
  }
  .row-media {
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  .row-media--graphic {
    display: flex;
    aspect-ratio: auto;
    overflow: visible;
  }
  .row-text :global(ul),
  .row-text :global(ol) {
    margin: 0 0 var(--space-4);
    padding-left: 1.25rem;
    list-style: disc;
  }
  .row-text :global(ol) {
    list-style: decimal;
  }
  .row-text :global(li) {
    margin-block: var(--space-2);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--read);
  }
  .row-text :global(li::marker) {
    color: var(--plume);
  }
  .row-text :global(a) {
    color: var(--plume);
    text-underline-offset: 3px;
  }
  /* Las tablas se desplazan dentro de su columna en lugar de ensancharla */
  .row-text :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }
  .row-text :global(strong) {
    font-weight: 600;
  }
  .row-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .row-text :global(h2),
  .row-text :global(h3) {
    margin: 0 0 var(--space-3);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.15;
    color: var(--plume);
  }
  .row-text :global(h3) {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
  }
  .row-text :global(p) {
    margin: 0 0 var(--space-4);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--read);
  }
  .row-text :global(h2:not(:first-child)),
  .row-text :global(h3:not(:first-child)) {
    margin-top: var(--space-8);
  }

  @media (min-width: 820px) {
    .row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-12);
      margin-block: var(--space-16);
    }
    .row--reverse .row-media {
      order: 2;
    }
    /* El grafico ocupa todo el alto del texto; si el texto es mas corto, el texto se centra */
    .row-media--graphic {
      align-self: stretch;
    }
    .row:has(.row-media--graphic) .row-text {
      align-self: center;
    }
  }
</style>

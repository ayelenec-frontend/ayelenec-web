---
// Imagen a pantalla completa (borde a borde) con epigrafe opcional.
interface Props {
  image: string;
  alt?: string;
  caption?: string;
}
const { image, alt = '', caption } = Astro.props;
---

<figure class="figure">
  <img src={image} alt={alt} loading="lazy" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-block: var(--space-16);
  }
  .figure img {
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    display: block;
    border-radius: 0;
  }
  .figure figcaption {
    margin: var(--space-3) auto 0;
    max-width: 720px;
    padding-inline: var(--space-6);
    text-align: center;
    font-size: 0.8125rem;
    color: var(--ink-muted);
  }
</style>

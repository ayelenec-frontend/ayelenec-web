---
import type { CollectionEntry } from 'astro:content';
import { t, type Lang } from '../i18n';
import CtaButton from './CtaButton.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
}
const { post, lang } = Astro.props;
const s = t[lang].blog;
const d = post.data;
const backHref = lang === 'en' ? '/en/blog' : '/blog';
const date = new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : 'es-AR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(d.pubDate);
---

<article class="post">
  <div class="container post-head">
    <a class="post-back" href={backHref}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      {s.back}
    </a>

    {
      d.tags.length > 0 && (
        <div class="post-tags">
          {d.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )
    }

    <h1 class="post-title">{d.title}</h1>
    <p class="post-meta">{date} · {d.readingTime}</p>
    <p class="post-lead">{d.description}</p>
  </div>

  {
    d.cover && (
      <div class="post-cover">
        <img src={d.cover} alt="" />
      </div>
    )
  }

  <div class="container post-body prose">
    <slot />
  </div>

  <div class="container post-foot">
    <div class="post-cta">
      <p>{s.cta}</p>
      <CtaButton label={s.ctaBtn} data-open-contact />
    </div>
  </div>
</article>

<style>
  .post {
    padding-top: 150px;
    padding-bottom: var(--space-24);
    overflow-x: clip; /* los bloques full-bleed no generan scroll horizontal */
  }

  .post-head {
    max-width: 760px;
  }

  .post-back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.9375rem;
    color: var(--ink-muted);
    text-decoration: none;
    transition: color 0.18s var(--ease);
  }
  .post-back:hover {
    color: var(--ink);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-8);
  }

  .post-title {
    margin-top: var(--space-4);
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.12;
  }

  .post-meta {
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .post-lead {
    margin-top: var(--space-5);
    font-size: 1.25rem;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .post-cover {
    margin: var(--space-12) auto 0;
    max-width: 1000px;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
  }
  .post-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-body {
    max-width: 720px;
    margin-top: var(--space-12);
  }

  .post-foot {
    max-width: 720px;
    margin-top: var(--space-16);
  }
  .post-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-8);
    border-radius: 16px;
    background-color: var(--surface-sunken);
  }
  .post-cta p {
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.3;
    max-width: 28ch;
  }

  /* ---- Prose (contenido markdown) ---- */
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(table),
  .prose :global(blockquote) {
    margin-block: var(--space-5);
  }
  .prose :global(p) {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--ink);
  }
  .prose :global(h2) {
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    font-size: 1.625rem;
    line-height: 1.2;
  }
  .prose :global(h3) {
    margin-top: var(--space-8);
    font-size: 1.25rem;
  }
  .prose :global(a) {
    color: var(--plume);
    text-underline-offset: 3px;
  }
  .prose :global(strong) {
    font-weight: 600;
    color: var(--ink);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
  }
  .prose :global(li) {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-block: var(--space-2);
  }
  .prose :global(li::marker) {
    color: var(--plume);
  }
  .prose :global(blockquote) {
    margin-inline: calc(-1 * var(--space-6));
    padding: var(--space-6) var(--space-8);
    border-left: 4px solid var(--plume);
    background-color: var(--surface-sunken);
    border-radius: 0 16px 16px 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.375rem;
    line-height: 1.45;
    color: var(--ink);
  }
  .prose :global(blockquote p) {
    margin: 0;
    font-size: inherit;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    padding: 2px 6px;
    border-radius: 6px;
    background-color: var(--surface-sunken);
  }

  /* Tablas: forma de tarjeta redondeada */
  .prose :global(table) {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.9375rem;
    background-color: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 13px 18px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
    line-height: 1.5;
  }
  .prose :global(tbody tr:last-child td) {
    border-bottom: 0;
  }
  .prose :global(thead th) {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    background-color: var(--surface-sunken);
  }
  .prose :global(tbody tr:nth-child(even)) {
    background-color: color-mix(in srgb, var(--surface-sunken) 30%, transparent);
  }

  /* Imagenes dentro del cuerpo: a todo el ancho de la columna */
  .prose > :global(img),
  .prose > :global(p > img) {
    display: block;
    width: 100%;
    border-radius: 14px;
    margin-block: var(--space-8);
  }
</style>

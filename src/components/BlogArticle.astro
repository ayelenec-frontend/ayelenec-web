---
import type { CollectionEntry } from 'astro:content';
import { t, type Lang } from '../i18n';
import CtaButton from './CtaButton.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
}
const { post, lang } = Astro.props;
const s = t[lang].blog;
const d = post.data;
const backHref = lang === 'en' ? '/en/blog' : '/blog';
const date = new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : 'es-AR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(d.pubDate);
---

<article class="post">
  <div class="container paper">
    <a class="post-back" href={backHref}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      {s.back}
    </a>

    <!-- Cabecera tipo diario: filetes, seccion + fecha, cabezal -->
    <header class="np-head">
      <div class="np-line">
        <span class="np-section">{d.tags.join(' · ')}</span>
        <span class="np-date">{date}{d.readingTime ? ` · ${d.readingTime}` : ''}</span>
      </div>
      <p class="np-mast" aria-hidden="true">{s.title}</p>
    </header>

    {
      d.cover && (
        <figure class="np-photo">
          <img src={d.cover} alt="" />
          {d.coverCaption && <figcaption>{d.coverCaption}</figcaption>}
        </figure>
      )
    }

    <div class="post-body prose np-cols">
      <header class="np-headline">
        <h1 class="post-title">{d.title}</h1>
        <p class="post-lead">{d.description}</p>
      </header>
      <slot />
    </div>
  </div>

  <div class="container post-foot">
    <div class="post-cta">
      {d.cta && d.cta.length > 0 ? d.cta.map((line) => <p>{line}</p>) : <p>{s.cta}</p>}
      <CtaButton label={s.ctaBtn} data-open-contact />
    </div>
  </div>
</article>

<style>
  .post {
    /* Color de lectura: en oscuro un marfil que se destaca del fondo marron */
    --read: var(--ink);
    --read-soft: var(--ink-muted);
    padding-top: 150px;
    padding-bottom: var(--space-24);
    overflow-x: clip; /* los bloques full-bleed no generan scroll horizontal */
  }
  :global(:root[data-theme='dark']) .post {
    --read: #f6f1e4;
    --read-soft: #d9d0bd;
  }

  .paper {
    max-width: 1120px;
  }

  .post-back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    font-size: 0.9375rem;
    color: var(--ink-muted);
    text-decoration: none;
    transition: color 0.18s var(--ease);
  }
  .post-back:hover {
    color: var(--ink);
  }

  /* ---- Estructura de diario ---- */
  .np-head {
    border-top: 5px solid var(--ink);
  }
  .np-line {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 5px double var(--ink);
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--ink-muted);
  }
  .np-mast {
    margin: var(--space-3) 0 0;
    padding: var(--space-3) 0;
    border-top: 3px dotted var(--ink);
    border-bottom: 3px dotted var(--ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(3.5rem, 13vw, 8rem);
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    text-align: center;
    color: var(--ink);
  }
  .np-head::after {
    content: '';
    display: block;
    height: 5px;
    margin-top: var(--space-3);
    background-color: var(--ink);
  }

  .np-photo {
    margin: var(--space-8) 0 0;
  }
  .np-photo img {
    display: block;
    width: 100%;
    max-height: 520px;
    object-fit: cover;
  }
  .np-photo figcaption {
    margin-top: var(--space-2);
    text-align: right;
    font-family: var(--font-display);
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  .post-body {
    margin-top: var(--space-8);
  }
  /* Texto en dos columnas, justificado */
  .np-cols {
    column-gap: 56px;
    text-align: left;
  }
  @media (min-width: 820px) {
    .np-cols {
      column-count: 2;
    }
    .np-cols :global(p),
    .np-cols :global(li) {
      text-align: justify;
      hyphens: auto;
    }
    /* Bloques anchos cortan las columnas y ocupan todo el ancho */
    .np-cols :global(.split),
    .np-cols :global(table),
    .np-cols :global(blockquote) {
      column-span: all;
    }
  }
  .np-cols :global(h2),
  .np-cols :global(h3) {
    break-after: avoid;
  }
  .np-cols :global(img),
  .np-cols :global(figure) {
    break-inside: avoid;
  }

  .np-headline {
    break-inside: avoid;
    padding-bottom: var(--space-5);
    margin-bottom: var(--space-4);
    border-bottom: 2px dotted var(--line-strong);
  }
  .post-title {
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--read);
  }
  .post-lead {
    margin-top: var(--space-4);
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--read-soft);
  }

  :global(.post-body > .split:first-child) {
    margin-top: 0;
  }

  .post-foot {
    max-width: 720px;
    margin-top: var(--space-16);
  }
  .post-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
    padding: var(--space-10, 2.5rem) var(--space-8);
    border-radius: 16px;
    background-color: var(--surface-sunken);
  }
  .post-cta p {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--read);
    max-width: 44ch;
    margin-inline: auto;
  }

  /* ---- Prose (contenido markdown) ---- */
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(table),
  .prose :global(blockquote) {
    margin-block: var(--space-5);
  }
  .prose :global(p) {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--read);
  }
  .prose :global(h2),
  .prose :global(h3) {
    color: var(--read);
  }
  .prose :global(h2) {
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    font-size: 1.625rem;
    line-height: 1.2;
  }
  .prose :global(h3) {
    margin-top: var(--space-8);
    font-size: 1.25rem;
  }
  .prose :global(a) {
    color: var(--plume);
    text-underline-offset: 3px;
  }
  .prose :global(strong) {
    font-weight: 600;
    color: var(--read);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
  }
  .prose :global(li) {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-block: var(--space-2);
    color: var(--read);
  }
  .prose :global(li::marker) {
    color: var(--plume);
  }
  .prose :global(blockquote) {
    margin-inline: calc(-1 * var(--space-6));
    padding: var(--space-6) var(--space-8);
    border-left: 4px solid var(--plume);
    background-color: var(--surface-sunken);
    border-radius: 0 16px 16px 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.375rem;
    line-height: 1.45;
    color: var(--ink);
  }
  .prose :global(blockquote p) {
    margin: 0;
    font-size: inherit;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    padding: 2px 6px;
    border-radius: 6px;
    background-color: var(--surface-sunken);
  }

  /* Tablas: forma de tarjeta redondeada */
  .prose :global(table) {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.9375rem;
    background-color: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 13px 18px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
    line-height: 1.5;
  }
  .prose :global(tbody tr:last-child td) {
    border-bottom: 0;
  }
  .prose :global(thead th) {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    background-color: var(--surface-sunken);
  }
  .prose :global(tbody tr:nth-child(even)) {
    background-color: color-mix(in srgb, var(--surface-sunken) 30%, var(--surface));
  }

  /* Imagenes dentro del cuerpo: a todo el ancho de la columna */
  .prose > :global(img),
  .prose > :global(p > img) {
    display: block;
    width: 100%;
    border-radius: 14px;
    margin-block: var(--space-8);
  }
</style>

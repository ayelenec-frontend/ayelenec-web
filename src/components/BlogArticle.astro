---
import type { CollectionEntry } from 'astro:content';
import { t, type Lang } from '../i18n';
import CtaButton from './CtaButton.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
}
const { post, lang } = Astro.props;
const s = t[lang].blog;
const d = post.data;
const backHref = lang === 'en' ? '/en/blog' : '/blog';
const date = new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : 'es-AR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(d.pubDate);
---

<article class="post">
  <header class:list={['post-hero', { 'has-cover': !!d.cover }]} style={d.cover ? `--cover: url('${d.cover}')` : undefined}>
    <div class="container post-head">
      <h1 class="post-title">{d.title}</h1>
      <p class="post-meta">
        {d.tags.length > 0 && <span>{d.tags.join(' · ')} — </span>}{date}{d.readingTime ? ` · ${d.readingTime}` : ''}
      </p>
    </div>
  </header>

  <div class="container post-body prose">
    <a class="post-back" href={backHref}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      {s.back}
    </a>
    {d.description && <p class="post-lead">{d.description}</p>}
    <slot />
  </div>

  <section class="post-foot">
    <div class="container post-cta">
      {d.cta && d.cta.length > 0 ? d.cta.map((line) => <p>{line}</p>) : <p>{s.cta}</p>}
      <CtaButton label={s.ctaBtn} data-open-contact onDark />
    </div>
  </section>
</article>

<style>
  .post {
    /* Color de lectura: en oscuro un marfil que se destaca del fondo marron */
    --read: var(--ink);
    --read-soft: var(--ink-muted);
    padding-top: 0;
    overflow-x: clip; /* los bloques full-bleed no generan scroll horizontal */
  }
  :global(:root[data-theme='dark']) .post {
    --read: #f6f1e4;
    --read-soft: #d9d0bd;
  }

  /* Franja de titulo: foto de fondo oscurecida con filtro (sin capas translucidas) */
  .post-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: 340px;
    padding: 170px 0 var(--space-12);
    background-color: #2e2a24;
    color: #f6efe2;
    text-align: center;
  }
  .post-hero.has-cover::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--cover);
    background-size: cover;
    background-position: center;
    filter: brightness(0.5) saturate(1.1);
  }
  .post-head {
    max-width: 900px;
  }
  .post-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 500;
    line-height: 1.1;
    color: #f6efe2;
    text-wrap: balance;
  }
  .post-meta {
    max-width: none;
    text-align: center;
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #d8cfbe;
  }

  /* ---- Cuerpo ---- */
  .post-body {
    max-width: 1120px;
    padding-top: var(--space-8);
    padding-bottom: var(--space-16);
  }
  .post-back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.9375rem;
    color: var(--ink-muted);
    text-decoration: none;
    transition: color 0.18s var(--ease);
  }
  .post-back:hover {
    color: var(--ink);
  }
  .post-lead {
    max-width: 720px;
    margin: var(--space-8) auto 0;
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.5;
    color: var(--read);
  }

  /* El texto suelto (sin bloque imagen-texto) queda en una columna de lectura */
  .post-body > :global(p),
  .post-body > :global(h2),
  .post-body > :global(h3),
  .post-body > :global(ul),
  .post-body > :global(ol),
  .post-body > :global(blockquote),
  .post-body > :global(table) {
    max-width: 720px;
    margin-inline: auto;
  }

  /* ---- Cierre: banda oscura con llamado a escribir ---- */
  .post-foot {
    background-color: #2e2a24;
    color: #f6efe2;
    text-align: center;
  }
  .post-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-16);
  }
  .post-cta p {
    max-width: 44ch;
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.4;
    color: #f6efe2;
  }
  .post-cta p + p {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    color: #d8cfbe;
  }

  /* ---- Prose (contenido markdown) ---- */
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(table),
  .prose :global(blockquote) {
    margin-block: var(--space-5);
  }
  .prose :global(p) {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--read);
  }
  .prose :global(h2),
  .prose :global(h3) {
    color: var(--read);
  }
  .prose :global(h2) {
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    font-size: 1.625rem;
    line-height: 1.2;
  }
  .prose :global(h3) {
    margin-top: var(--space-8);
    font-size: 1.25rem;
  }
  .prose :global(a) {
    color: var(--plume);
    text-underline-offset: 3px;
  }
  .prose :global(strong) {
    font-weight: 600;
    color: var(--read);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
  }
  .prose :global(li) {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-block: var(--space-2);
    color: var(--read);
  }
  .prose :global(li::marker) {
    color: var(--plume);
  }
  .prose :global(blockquote) {
    margin-inline: auto;
    padding: var(--space-6) var(--space-8);
    border-left: 4px solid var(--plume);
    background-color: var(--surface-sunken);
    border-radius: 0 16px 16px 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.375rem;
    line-height: 1.45;
    color: var(--ink);
  }
  .prose :global(blockquote p) {
    margin: 0;
    font-size: inherit;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    padding: 2px 6px;
    border-radius: 6px;
    background-color: var(--surface-sunken);
  }

  /* Tablas: forma de tarjeta redondeada */
  .prose :global(table) {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.9375rem;
    background-color: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 13px 18px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
    line-height: 1.5;
  }
  .prose :global(tbody tr:last-child td) {
    border-bottom: 0;
  }
  .prose :global(thead th) {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    background-color: var(--surface-sunken);
  }
  .prose :global(tbody tr:nth-child(even)) {
    background-color: color-mix(in srgb, var(--surface-sunken) 30%, var(--surface));
  }

  /* Imagenes dentro del cuerpo: a todo el ancho de la columna */
  .prose > :global(img),
  .prose > :global(p > img) {
    display: block;
    width: 100%;
    border-radius: 14px;
    margin-block: var(--space-8);
  }
</style>

---
// Mejoras de comportamiento que se cargan una sola vez en todo el sitio:
//  1. Menu desplegable propio para los <select> del formulario (la lista nativa
//     del sistema no respeta la paleta ni el tema).
//  2. Animaciones de entrada al hacer scroll.
---

<script is:inline>
  document.documentElement.classList.add('js');
</script>

<script>
  /* ---------- 1. Dropdown propio ---------- */
  function enhanceSelect(select: HTMLSelectElement) {
    if (select.dataset.dd) return;
    select.dataset.dd = '1';
    const wrap = select.parentElement as HTMLElement;
    wrap.classList.add('dd');
    select.classList.add('dd-native');
    select.tabIndex = -1;
    select.setAttribute('aria-hidden', 'true');

    const label = select.id ? document.querySelector<HTMLLabelElement>(`label[for="${select.id}"]`) : null;
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'dd-btn';
    btn.setAttribute('aria-haspopup', 'listbox');
    btn.setAttribute('aria-expanded', 'false');
    if (label) {
      label.id ||= `${select.id}-label`;
      btn.setAttribute('aria-labelledby', label.id);
    }
    const text = document.createElement('span');
    btn.appendChild(text);

    const list = document.createElement('ul');
    list.className = 'dd-list';
    list.setAttribute('role', 'listbox');
    list.hidden = true;
    if (label) list.setAttribute('aria-labelledby', label.id);

    const options = Array.from(select.options);
    const items = options.map((opt, i) => {
      const li = document.createElement('li');
      li.setAttribute('role', 'option');
      li.textContent = opt.textContent;
      li.dataset.index = String(i);
      if (opt.value === '') li.classList.add('dd-placeholder');
      list.appendChild(li);
      return li;
    });

    wrap.insertBefore(btn, select.nextSibling);
    wrap.appendChild(list);

    let active = select.selectedIndex;

    const paint = () => {
      const cur = select.selectedIndex;
      text.textContent = options[cur]?.textContent ?? '';
      btn.classList.toggle('is-empty', options[cur]?.value === '');
      items.forEach((li, i) => {
        li.setAttribute('aria-selected', String(i === cur));
        li.classList.toggle('is-active', i === active);
      });
    };
    const open = () => {
      active = select.selectedIndex;
      list.hidden = false;
      const rect = btn.getBoundingClientRect();
      wrap.classList.toggle('dd-up', window.innerHeight - rect.bottom < 250 && rect.top > 250);
      btn.setAttribute('aria-expanded', 'true');
      paint();
      items[active]?.scrollIntoView({ block: 'nearest' });
    };
    const close = () => {
      list.hidden = true;
      btn.setAttribute('aria-expanded', 'false');
    };
    const choose = (i: number) => {
      select.selectedIndex = i;
      select.dispatchEvent(new Event('change', { bubbles: true }));
      active = i;
      paint();
      close();
      btn.focus();
    };
    const move = (d: number) => {
      active = Math.min(items.length - 1, Math.max(0, active + d));
      paint();
      items[active]?.scrollIntoView({ block: 'nearest' });
    };

    btn.addEventListener('click', () => (list.hidden ? open() : close()));
    items.forEach((li, i) => {
      li.addEventListener('mousedown', (e) => e.preventDefault());
      li.addEventListener('click', () => choose(i));
      li.addEventListener('mousemove', () => {
        active = i;
        paint();
      });
    });
    btn.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (list.hidden) open();
        else move(e.key === 'ArrowDown' ? 1 : -1);
      } else if (e.key === 'Home' || e.key === 'End') {
        if (!list.hidden) {
          e.preventDefault();
          active = e.key === 'Home' ? 0 : items.length - 1;
          paint();
        }
      } else if ((e.key === 'Enter' || e.key === ' ') && !list.hidden) {
        e.preventDefault();
        choose(active);
      } else if (e.key === 'Escape' && !list.hidden) {
        e.preventDefault();
        e.stopPropagation(); // que no cierre tambien el popup del formulario
        close();
      } else if (e.key === 'Tab') {
        close();
      }
    });
    document.addEventListener('click', (e) => {
      if (!wrap.contains(e.target as Node)) close();
    });
    select.form?.addEventListener('reset', () => setTimeout(paint, 0));
    paint();
  }
  document.querySelectorAll<HTMLSelectElement>('.select-wrap select, .cm-select select').forEach(enhanceSelect);

  /* ---------- 2. Animaciones al hacer scroll ---------- */
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = Array.from(
    document.querySelectorAll<HTMLElement>(
      [
        '#servicios .services-head > *',
        '.service-card',
        '.process-head > *',
        '.process .step',
        '.process-visual',
        '#proyectos .section-head > *',
        '.pc',
        '.about-banner',
        '.contact-intro > *',
        '.contact-form',
        '.footer-cols > *',
      ].join(',')
    )
  );
  if (reduce || !('IntersectionObserver' in window)) {
    targets.forEach((el) => el.classList.add('in'));
  } else {
    // escalonado: cada hermano entra un poco despues del anterior
    targets.forEach((el) => {
      el.classList.add('reveal');
      const sibs = Array.from(el.parentElement?.children ?? []).filter((c) => c.classList.contains('reveal') || targets.includes(c as HTMLElement));
      el.style.setProperty('--rd', `${Math.min(sibs.indexOf(el), 5) * 90}ms`);
    });
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
    );
    targets.forEach((el) => io.observe(el));
  }
</script>

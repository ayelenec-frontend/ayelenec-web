---
import { site, nav } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
import CtaButton from './CtaButton.astro';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="#top" aria-label={`${site.name} — inicio`}>{site.name}</a>

    <nav class="nav" aria-label="Principal">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="header-actions">
      <ThemeToggle />
      <CtaButton label="Escribime" small data-open-contact />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: color-mix(in srgb, var(--surface) 86%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: 64px;
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.375rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .nav {
    display: none;
    gap: var(--space-8);
    margin-left: auto;
  }

  .nav a {
    font-size: 0.9375rem;
    color: var(--ink-muted);
    transition: color 0.18s var(--ease);
  }

  .nav a:hover {
    color: var(--ink);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  @media (min-width: 880px) {
    .nav {
      display: flex;
    }
  }
</style>

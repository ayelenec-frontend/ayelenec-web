---
import { site, nav } from '../data/site';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="#top" aria-label={`${site.name} — inicio`}>{site.name}</a>

    <nav class="nav" aria-label="Principal">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="header-actions">
      <!-- Toggle de tema (sol/luna). Adaptado de un componente MIT de Uiverse
           (RiccardoRapelli) a la paleta de marca y atado a data-theme. -->
      <label class="theme-switch" title="Cambiar tema">
        <span class="sr-only">Cambiar entre tema claro y oscuro</span>
        <input id="theme-switch" type="checkbox" aria-label="Cambiar tema" />
        <span class="slider round">
          <span class="sun-moon">
            <svg id="moon-dot-1" class="moon-dot" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" /></svg>
            <svg id="moon-dot-2" class="moon-dot" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" /></svg>
            <svg id="moon-dot-3" class="moon-dot" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" /></svg>
            <svg id="light-ray-1" class="light-ray" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" /></svg>
            <svg id="light-ray-2" class="light-ray" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" /></svg>
            <svg id="light-ray-3" class="light-ray" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" /></svg>
            <svg id="cloud-1" class="cloud-dark" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" /></svg>
            <svg id="cloud-2" class="cloud-dark" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" /></svg>
            <svg id="cloud-3" class="cloud-dark" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" /></svg>
            <svg id="cloud-4" class="cloud-light" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" /></svg>
            <svg id="cloud-5" class="cloud-light" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" /></svg>
            <svg id="cloud-6" class="cloud-light" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" /></svg>
          </span>
          <span class="stars">
            <svg id="star-1" class="star" viewBox="0 0 20 20"><path d="M 0 10 C 10 10,10 10 ,0 10 C 10 10 , 10 10 , 10 20 C 10 10 , 10 10 , 20 10 C 10 10 , 10 10 , 10 0 C 10 10,10 10 ,0 10 Z" /></svg>
            <svg id="star-2" class="star" viewBox="0 0 20 20"><path d="M 0 10 C 10 10,10 10 ,0 10 C 10 10 , 10 10 , 10 20 C 10 10 , 10 10 , 20 10 C 10 10 , 10 10 , 10 0 C 10 10,10 10 ,0 10 Z" /></svg>
            <svg id="star-3" class="star" viewBox="0 0 20 20"><path d="M 0 10 C 10 10,10 10 ,0 10 C 10 10 , 10 10 , 10 20 C 10 10 , 10 10 , 20 10 C 10 10 , 10 10 , 10 0 C 10 10,10 10 ,0 10 Z" /></svg>
            <svg id="star-4" class="star" viewBox="0 0 20 20"><path d="M 0 10 C 10 10,10 10 ,0 10 C 10 10 , 10 10 , 10 20 C 10 10 , 10 10 , 20 10 C 10 10 , 10 10 , 10 0 C 10 10,10 10 ,0 10 Z" /></svg>
          </span>
        </span>
      </label>

      <button class="btn btn-primary btn-small" type="button" data-open-contact>Escribime</button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: color-mix(in srgb, var(--surface) 86%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: 64px;
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.375rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .nav {
    display: none;
    gap: var(--space-8);
    margin-left: auto;
  }

  .nav a {
    font-size: 0.9375rem;
    color: var(--ink-muted);
    transition: color 0.18s var(--ease);
  }

  .nav a:hover {
    color: var(--ink);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  /* ---------- Toggle de tema sol/luna ---------- */
  .theme-switch {
    position: relative;
    display: inline-block;
    width: 56px;
    height: 30px;
    flex-shrink: 0;
    vertical-align: middle;
  }

  .theme-switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .slider {
    position: absolute;
    inset: 0;
    cursor: pointer;
    background-color: #a99ad0; /* cielo de día (lavanda) */
    transition: background-color 0.4s var(--ease);
    overflow: hidden;
  }

  .slider.round {
    border-radius: var(--radius-pill);
  }

  .slider.round .sun-moon {
    border-radius: 50%;
  }

  .sun-moon {
    position: absolute;
    height: 22px;
    width: 22px;
    left: 4px;
    bottom: 4px;
    background-color: #f2ce73; /* sol cálido */
    transition: transform 0.4s var(--ease), background-color 0.4s var(--ease);
  }

  .moon-dot {
    position: absolute;
    opacity: 0;
    transition: 0.4s var(--ease);
    fill: #a99cb5;
  }

  #moon-dot-1 { left: 10px; top: 3px; width: 6px; height: 6px; z-index: 4; }
  #moon-dot-2 { left: 2px; top: 10px; width: 10px; height: 10px; z-index: 4; }
  #moon-dot-3 { left: 16px; top: 18px; width: 3px; height: 3px; z-index: 4; }

  .light-ray {
    position: absolute;
    z-index: -1;
    fill: #ffffff;
    opacity: 0.12;
  }

  #light-ray-1 { left: -8px; top: -8px; width: 38px; height: 38px; }
  #light-ray-2 { left: -50%; top: -50%; width: 48px; height: 48px; }
  #light-ray-3 { left: -18px; top: -18px; width: 52px; height: 52px; }

  .cloud-light { position: absolute; fill: #f7f9ec; animation: cloud-move 6s infinite; }
  .cloud-dark { position: absolute; fill: #e4ded0; animation: cloud-move 6s infinite; animation-delay: 1s; }

  #cloud-1 { left: 28px; top: 13px; width: 36px; }
  #cloud-2 { left: 40px; top: 9px; width: 18px; }
  #cloud-3 { left: 16px; top: 22px; width: 28px; }
  #cloud-4 { left: 32px; top: 16px; width: 36px; }
  #cloud-5 { left: 44px; top: 12px; width: 18px; }
  #cloud-6 { left: 20px; top: 24px; width: 28px; }

  @keyframes cloud-move {
    0% { transform: translateX(0); }
    40% { transform: translateX(4px); }
    80% { transform: translateX(-4px); }
    100% { transform: translateX(0); }
  }

  .stars {
    transform: translateY(-32px);
    opacity: 0;
    transition: 0.4s var(--ease);
  }

  .star {
    position: absolute;
    fill: #f7f9ec;
    transition: 0.4s var(--ease);
    animation: star-twinkle 2s infinite;
  }

  #star-1 { width: 18px; top: 2px; left: 3px; animation-delay: 0.3s; }
  #star-2 { width: 6px; top: 14px; left: 3px; }
  #star-3 { width: 11px; top: 18px; left: 9px; animation-delay: 0.6s; }
  #star-4 { width: 16px; top: 0; left: 16px; animation-delay: 1.3s; }

  @keyframes star-twinkle {
    0% { transform: scale(1); }
    40% { transform: scale(1.2); }
    80% { transform: scale(0.8); }
    100% { transform: scale(1); }
  }

  /* Estado "noche": lo controla el tema real (data-theme), no el checkbox,
     para que coincida con el script anti-flash y no parpadee al cargar. */
  :global(:root[data-theme='dark']) .slider {
    background-color: #1c1726; /* cielo de noche (plume oscuro) */
  }

  :global(:root[data-theme='dark']) .sun-moon {
    transform: translateX(26px);
    background-color: #f4f2e6; /* luna (linen) */
  }

  :global(:root[data-theme='dark']) .moon-dot {
    opacity: 1;
  }

  :global(:root[data-theme='dark']) .stars {
    transform: translateY(0);
    opacity: 1;
  }

  /* Foco de teclado con el anillo de marca */
  .theme-switch input:focus-visible + .slider {
    outline: 2px solid var(--plume);
    outline-offset: 2px;
  }

  @media (min-width: 880px) {
    .nav {
      display: flex;
    }
  }
</style>

<script>
  const input = document.getElementById('theme-switch') as HTMLInputElement | null;
  if (input) {
    const root = document.documentElement;
    // El checkbox arranca reflejando el tema que fijó el script anti-flash.
    input.checked = root.getAttribute('data-theme') === 'dark';
    input.addEventListener('change', () => {
      const next = input.checked ? 'dark' : 'light';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch (e) {
        /* almacenamiento no disponible: el cambio aplica igual en esta sesion */
      }
    });
  }
</script>

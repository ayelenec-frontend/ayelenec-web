---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-id">
      <span class="footer-name">{site.name}</span>
      <span class="footer-role">{site.role}</span>
    </div>
    <p class="footer-tagline">{site.tagline}</p>
    <span class="footer-copy">© {year} {site.name}</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: var(--space-12);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .footer-id {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .footer-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.25rem;
  }

  .footer-role {
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  .footer-tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.125rem;
    color: var(--plume);
  }

  .footer-copy {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }
</style>

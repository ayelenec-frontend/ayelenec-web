---
import { about, site } from '../data/site';
---

<section class="section" id="sobre-mi">
  <div class="container about-grid">
    <div class="about-aside">
      <div class="portrait">
        {
          about.portrait ? (
            <img src={about.portrait} alt={site.name} loading="lazy" width="600" height="750" />
          ) : (
            <span class="portrait-note">Tu retrato</span>
          )
        }
      </div>
    </div>

    <div class="about-text">
      <span class="eyebrow">Sobre mí</span>
      <h2 class="about-hi">Hola, soy <span class="accent">Ayelen</span>.</h2>

      {about.bio.slice(0, 2).map((paragraph) => <p class="about-bio">{paragraph}</p>)}

      <p class="about-phrase">{site.tagline}</p>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10, 2.5rem);
    align-items: center;
  }

  @media (min-width: 860px) {
    .about-grid {
      grid-template-columns: 0.8fr 1.2fr;
      gap: var(--space-16);
    }
  }

  .about-aside {
    display: flex;
    justify-content: center;
  }

  .portrait {
    width: 100%;
    max-width: 300px;
    aspect-ratio: 3 / 4;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--sky);
    border-radius: 150px 150px 18px 18px;
    overflow: hidden;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portrait-note {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--brand-night) 55%, var(--sky));
  }

  .about-hi {
    margin-top: var(--space-6);
    font-size: clamp(1.9rem, 5vw, 2.75rem);
  }

  .about-bio {
    color: var(--ink-muted);
    max-width: 58ch;
    margin-top: var(--space-6);
    line-height: 1.68;
  }

  .about-phrase {
    margin-top: var(--space-6);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--plume);
  }
</style>

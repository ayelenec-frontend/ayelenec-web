---
import { about, site } from '../data/site';
import { getLang, t } from '../i18n';

const lang = getLang(Astro.url);
const s = t[lang].about;
---

<section class="section" id="sobre-mi">
  <div class="container">
    <div class="about-banner">
      <div class="about-text">
        <span class="about-eyebrow">{s.eyebrow}</span>
        <h2 class="about-hi">{s.hiLead}<mark class="about-mark">{s.hiName}</mark>.</h2>

        {s.bio.map((paragraph) => <p class="about-bio">{paragraph}</p>)}

        <p class="about-phrase">{s.phrase}</p>
      </div>

      <div class="about-aside">
        {
          about.portrait ? (
            <div class="portrait">
              <img src={about.portrait} alt={site.name} loading="lazy" width="600" height="750" />
            </div>
          ) : (
            <img class="about-badge" src="/ac-badge.svg" alt="" width="240" height="240" loading="lazy" />
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .about-banner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
    padding: var(--space-8);
    border-radius: 28px;
    /* Colores fijos: el banner es ciruela profundo en claro y en oscuro */
    background-color: #4a3236;
    color: #f2ece0;
    box-shadow: 0 30px 60px -36px rgb(46 42 36 / 0.6);
  }
  @media (min-width: 860px) {
    .about-banner {
      grid-template-columns: 1.3fr 0.7fr;
      gap: var(--space-16);
      padding: var(--space-16);
    }
  }

  .about-eyebrow {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .about-hi {
    margin-top: var(--space-3);
    font-size: var(--title-size);
    line-height: 1.04;
    color: #f2ece0;
  }
  /* Nombre: negrita, sin cursiva ni marcador */
  .about-mark {
    background: none;
    color: #f2b891; /* terracota claro: resalta sobre el ciruela */
    font-style: normal;
    font-weight: 600;
  }

  .about-bio {
    max-width: 58ch;
    margin-top: var(--space-6);
    line-height: 1.68;
    color: #f2ece0;
    opacity: 0.92;
  }

  .about-phrase {
    margin-top: var(--space-6);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.375rem;
    color: #f2ece0;
  }

  .about-aside {
    display: flex;
    justify-content: center;
  }
  .about-badge {
    width: min(240px, 60vw);
    height: auto;
    border-radius: 50%;
    transform: rotate(-6deg);
  }
  .portrait {
    width: 100%;
    max-width: 300px;
    aspect-ratio: 3 / 4;
    border-radius: 150px 150px 18px 18px;
    overflow: hidden;
    background-color: #ECE3D3; /* la foto es un recorte: este es su fondo (crema claro de la marca) */
  }
  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

---
import { services } from '../data/site';

const left = services.slice(0, 2);
const right = services.slice(2, 4);
---

<section class="section services" id="servicios">
  <div class="container">
    <div class="services-head">
      <span class="services-leaf" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
          <path
            d="M12 21c0-6 2-10 8-12-1 6-3 9-8 10m0 2c0-5-2-8-7-9 1 5 3 7 7 7"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </span>
      <h2>Qué hago</h2>
    </div>

    <div class="services-cols">
      <div class="services-col">
        <p class="services-intro">
          Investigación, arquitectura de información y prototipos en Figma; sitios
          institucionales y e-commerce en WordPress, Webflow o Shopify.
        </p>
        <ul class="service-bands">
          {
            left.map((service) => (
              <li class="service-band">
                <span class="service-band-num">{service.number}</span>
                <span class="service-band-title">{service.title}</span>
                <svg class="service-band-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="services-col">
        <ul class="service-bands">
          {
            right.map((service) => (
              <li class="service-band">
                <span class="service-band-num">{service.number}</span>
                <span class="service-band-title">{service.title}</span>
                <svg class="service-band-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </li>
            ))
          }
        </ul>
        <p class="services-intro">
          Identidad visual y piezas gráficas para redes y campañas; y MVPs con
          no-code e IA para validar ideas antes de invertir en desarrollo.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .services-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
    margin-bottom: var(--space-10, 2.5rem);
  }
  .services-leaf {
    color: var(--plume);
    display: inline-flex;
  }

  .services-cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    max-width: 920px;
    margin-inline: auto;
  }
  @media (min-width: 768px) {
    .services-cols {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-12);
    }
  }

  .services-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .services-intro {
    color: var(--ink-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .service-bands {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .service-band {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 16px 22px;
    border-radius: 14px;
    background-color: var(--plume);
    color: var(--on-plume);
    cursor: default;
    transition: background-color 0.25s var(--ease), transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .service-band:hover {
    background-color: var(--plume-deep);
    transform: translateX(6px);
    box-shadow: -6px 10px 24px -14px color-mix(in srgb, var(--ink) 60%, transparent);
  }

  .service-band-arrow {
    margin-left: auto;
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .service-band:hover .service-band-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .service-band,
    .service-band-arrow {
      transition: none;
    }
    .service-band:hover {
      transform: none;
    }
  }

  .service-band-num {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    opacity: 0.7;
  }

  .service-band-title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 500;
  }
</style>

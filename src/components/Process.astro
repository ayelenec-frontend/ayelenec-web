---
import { process } from '../data/site';
---

<section class="section" id="proceso">
  <div class="container">
    <div class="process-head">
      <span class="eyebrow">Proceso</span>
      <h2>Primero la estructura, después el detalle.</h2>
    </div>

    <ol class="process-flow">
      {
        process.map((step, i) => (
          <>
            <li class="step">
              <span class="step-circle">{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </li>
            {i < process.length - 1 && (
              <li class="conn" aria-hidden="true">
                <span class="conn-dot" />
              </li>
            )}
          </>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process-head {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .process-flow {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  @media (min-width: 880px) {
    .process-flow {
      flex-direction: row;
      align-items: flex-start;
      justify-content: center;
    }
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
  }
  @media (min-width: 880px) {
    .step {
      flex: 1 1 0;
      min-width: 0;
      max-width: 220px;
    }
  }

  .step-circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 0;
    background-color: var(--plume);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    color: var(--on-plume);
  }

  .step h3 {
    font-size: 1.1875rem;
    min-height: 2.5em;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .step p {
    color: var(--ink-muted);
    font-size: 0.9rem;
    line-height: 1.55;
    max-width: 24ch;
  }

  /* ---- Conector animado ---- */
  .conn {
    position: relative;
    overflow: hidden;
    background-color: var(--line);
    align-self: center;
    width: 2px;
    height: 28px;
    flex: 0 0 auto;
  }
  .conn-dot {
    position: absolute;
    left: -2px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--plume);
    animation: conn-down 1.8s var(--ease) infinite;
  }

  @media (min-width: 880px) {
    .conn {
      width: auto;
      flex: 1 1 0;
      max-width: 90px;
      height: 2px;
      margin-top: 27px;
    }
    .conn-dot {
      left: 0;
      top: -2px;
      animation-name: conn-right;
    }
  }

  @keyframes conn-down {
    0% { top: -6px; opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { top: 28px; opacity: 0; }
  }
  @keyframes conn-right {
    0% { left: -6px; opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { left: calc(100% + 6px); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .conn-dot {
      animation: none;
      left: 0;
      top: 11px;
    }
  }
</style>

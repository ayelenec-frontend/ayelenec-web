---
import { contact, site } from '../data/site';
import CtaButton from './CtaButton.astro';

const socials = site.social.filter((s) => s.href);
---

<section class="contact" id="contacto">
  <div class="container">
    <span class="contact-eyebrow">Contacto</span>
    <h2 class="contact-title">
      {contact.titleLead}<span class="contact-accent">{contact.titleAccent}</span>
    </h2>
    <p class="contact-text">{contact.text}</p>

    <div class="contact-actions">
      <CtaButton label="Escribime" onDark data-open-contact />
      <a class="btn contact-btn-ghost" href={`mailto:${site.email}`}>{site.email}</a>
      {
        socials.map((s) => (
          <a class="btn contact-btn-ghost" href={s.href} target="_blank" rel="noopener">
            {s.label} ↗
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Banda oscura (Night) en ambos temas: colores fijos de marca. */
  .contact {
    background-color: #17131b;
    color: #f1f2e4;
    padding-block: var(--space-24);
  }

  .contact-eyebrow {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #b4abbb;
  }

  .contact-title {
    margin-top: var(--space-3);
    font-size: clamp(2rem, 6vw, 3.25rem);
    line-height: 1.02;
    max-width: 18ch;
  }

  .contact-accent {
    font-style: italic;
    color: #bc9fd6;
  }

  .contact-text {
    margin-top: var(--space-6);
    color: #b4abbb;
    font-size: 1.1875rem;
    max-width: 48ch;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-12);
  }

  .contact-btn-ghost {
    background-color: transparent;
    color: #f1f2e4;
    border-color: #7a6f82;
  }

  .contact-btn-ghost:hover {
    border-color: #bc9fd6;
    color: #bc9fd6;
  }
</style>

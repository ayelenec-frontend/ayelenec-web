---
import type { Project } from '../data/projects';
import { getLang, t } from '../i18n';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const lang = getLang(Astro.url);
const s = t[lang].project;
const prefix = lang === 'en' ? '/en' : '';
---

<main id="contenido" class="case">
  <div class="container case-inner">
    <a class="case-back" href={`${prefix}/preview#proyectos`}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      {s.back}
    </a>

    <header class="case-head">
      <div class="case-meta">
        <span class="tag">{project.discipline}</span>
        <span class="case-country">{project.client} · {project.country}</span>
      </div>
      <h1 class="case-title">{project.title[lang]}</h1>
      <p class="case-lead">{project.description[lang]}</p>
    </header>

    <div class="case-media media--night">
      <span class="media-label">{project.client}</span>
    </div>

    <div class="case-cols">
      <div class="case-block">
        <h2 class="case-h">{s.tools}</h2>
        <ul class="case-tools">
          {project.tools.map((tool) => <li class="chip">{tool}</li>)}
        </ul>
      </div>

      {
        project.result && (
          <div class="case-block">
            <h2 class="case-h">{s.result}</h2>
            <p class="case-result">{project.result[lang]}</p>
          </div>
        )
      }
    </div>

    <p class="case-note">{s.soon}</p>
  </div>
</main>

<style>
  .case {
    padding-block: var(--space-12) var(--space-16, 5rem);
  }
  .case-inner {
    max-width: 820px;
  }

  .case-back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.9375rem;
    color: var(--ink-muted);
    text-decoration: none;
    transition: color 0.18s var(--ease);
  }
  .case-back:hover {
    color: var(--ink);
  }

  .case-head {
    margin-top: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .case-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .case-country {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }
  .case-title {
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    line-height: 1.1;
  }
  .case-lead {
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--ink-muted);
    max-width: 60ch;
  }

  .case-media {
    margin-top: var(--space-8);
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 16px;
    background-color: var(--brand-night);
  }
  .case-media .media-label {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 500;
    color: #f7f9ec;
  }

  .case-cols {
    margin-top: var(--space-10, 2.5rem);
    display: grid;
    gap: var(--space-8);
    grid-template-columns: 1fr;
  }
  @media (min-width: 620px) {
    .case-cols {
      grid-template-columns: 1fr 1fr;
    }
  }
  .case-h {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-muted);
    margin-bottom: var(--space-3);
  }
  .case-tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .case-result {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--plume);
  }

  .case-note {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }
</style>

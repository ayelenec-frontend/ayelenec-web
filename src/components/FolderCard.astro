---
import type { CollectionEntry } from 'astro:content';
import { t, type Lang } from '../i18n';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
}
const { post, lang } = Astro.props;
const s = t[lang].blog;
const href = `${lang === 'en' ? '/en' : ''}/blog/${post.slug}`;
const date = new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : 'es-AR', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
}).format(post.data.pubDate);
---

<a class="folder" href={href}>
  <span class="folder-tab" aria-hidden="true"></span>

  <span class="folder-photo" aria-hidden="true">
    {post.data.cover ? <img src={post.data.cover} alt="" loading="lazy" /> : <span class="folder-photo-fallback" />}
  </span>

  <span class="folder-sheet">
    <span class="folder-date">{date} · {post.data.readingTime}</span>
    <span class="folder-title">{post.data.title}</span>
    <span class="folder-abstract">{post.data.description}</span>
    <span class="folder-read">{s.readMore} <span aria-hidden="true">→</span></span>
  </span>
</a>

<style>
  .folder {
    --folder: #d8c9a8;
    --sheet: #f4eee0;
    --photo: var(--sky);
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 46px 16px 18px;
    border-radius: 3px 16px 16px 16px;
    background-color: var(--folder);
    color: var(--ink);
    text-decoration: none;
    box-shadow: 0 14px 34px -18px rgba(46, 42, 36, 0.55);
    transition: transform 0.28s var(--ease), box-shadow 0.28s var(--ease);
  }

  :global(:root[data-theme='dark']) .folder {
    --folder: #3a3127;
    --sheet: #2c261f;
    --photo: #5f7375;
  }

  /* Pestaña de la carpeta */
  .folder-tab {
    position: absolute;
    top: -15px;
    left: 18px;
    width: 96px;
    height: 16px;
    background-color: var(--folder);
    border-radius: 9px 9px 0 0;
  }

  /* Foto/papel que asoma arriba */
  .folder-photo {
    position: relative;
    z-index: 1;
    display: block;
    margin: 0 10px -26px;
    aspect-ratio: 5 / 4;
    border: 6px solid #fbf7ec;
    border-radius: 2px;
    overflow: hidden;
    transform: rotate(-2.2deg);
    box-shadow: 0 8px 18px -10px rgba(46, 42, 36, 0.5);
    transition: transform 0.28s var(--ease);
  }
  .folder-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .folder-photo-fallback {
    display: block;
    width: 100%;
    height: 100%;
    background-color: var(--photo);
  }

  /* Ficha del frente */
  .folder-sheet {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    border-radius: 8px;
    background-color: var(--sheet);
  }

  .folder-date {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .folder-title {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    line-height: 1.2;
    color: var(--ink);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .folder-abstract {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .folder-read {
    margin-top: var(--space-2);
    font-weight: 500;
    font-size: 0.875rem;
    color: var(--plume);
  }

  .folder:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 44px -20px rgba(46, 42, 36, 0.6);
  }
  .folder:hover .folder-photo {
    transform: rotate(-3.5deg) translateY(-3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .folder,
    .folder-photo {
      transition: none;
    }
  }
</style>

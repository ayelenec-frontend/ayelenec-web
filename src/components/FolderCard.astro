---
import type { CollectionEntry } from 'astro:content';
import { t, type Lang } from '../i18n';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
}
const { post, lang } = Astro.props;
const s = t[lang].blog;
const href = `${lang === 'en' ? '/en' : ''}/blog/${post.slug}`;
const date = new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : 'es-AR', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
}).format(post.data.pubDate);
---

<a class="folder" href={href}>
  <span class="folder-tab" aria-hidden="true"></span>

  <span class="folder-photo" aria-hidden="true">
    {post.data.cover ? <img src={post.data.cover} alt="" loading="lazy" /> : <span class="folder-photo-fallback" />}
  </span>

  <span class="folder-sheet">
    <span class="folder-date">{date} · {post.data.readingTime}</span>
    <span class="folder-title">{post.data.title}</span>
    <span class="folder-abstract">{post.data.description}</span>
    <span class="folder-read">{s.readMore} <span aria-hidden="true">→</span></span>
  </span>
</a>

<style>
  .folder {
    --folder: #dccca6;
    --folder-edge: #cdbb92;
    --sheet: #f7f2e7;
    --photo: var(--sky);
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 56px 20px 22px;
    border-radius: 8px 22px 22px 22px;
    background-image: linear-gradient(180deg, var(--folder), var(--folder-edge));
    color: var(--ink);
    text-decoration: none;
    box-shadow: 0 18px 40px -22px rgba(46, 42, 36, 0.5);
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }

  :global(:root[data-theme='dark']) .folder {
    --folder: #45392c;
    --folder-edge: #3a3024;
    --sheet: #2e2820;
    --photo: #67807f;
  }

  /* Pestaña de la carpeta */
  .folder-tab {
    position: absolute;
    top: -14px;
    left: 22px;
    width: 104px;
    height: 16px;
    background-color: var(--folder);
    border-radius: 12px 12px 0 0;
  }

  /* Foto/papel que asoma arriba */
  .folder-photo {
    position: relative;
    z-index: 1;
    display: block;
    margin: 0 16px -34px;
    aspect-ratio: 5 / 4;
    border: 8px solid #fbf7ec;
    border-radius: 4px;
    overflow: hidden;
    transform: rotate(-2deg);
    box-shadow: 0 12px 22px -12px rgba(46, 42, 36, 0.45);
    transition: transform 0.3s var(--ease);
  }
  .folder-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .folder-photo-fallback {
    display: block;
    width: 100%;
    height: 100%;
    background-color: var(--photo);
  }

  /* Ficha del frente */
  .folder-sheet {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-6) var(--space-7, 1.75rem);
    border-radius: 14px;
    background-color: var(--sheet);
    box-shadow: 0 2px 10px -6px rgba(46, 42, 36, 0.3);
  }

  .folder-date {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .folder-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.25;
    color: var(--ink);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .folder-abstract {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--ink-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .folder-read {
    margin-top: var(--space-2);
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--plume);
  }

  .folder:hover {
    transform: translateY(-5px) rotate(-0.4deg);
    box-shadow: 0 28px 52px -24px rgba(46, 42, 36, 0.58);
  }
  .folder:hover .folder-photo {
    transform: rotate(-3.2deg) translateY(-4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .folder,
    .folder-photo {
      transition: none;
    }
  }
</style>

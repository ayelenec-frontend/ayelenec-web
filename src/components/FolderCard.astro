---
import type { CollectionEntry } from 'astro:content';
import { t, type Lang } from '../i18n';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
}
const { post, lang } = Astro.props;
const s = t[lang].blog;
const href = `${lang === 'en' ? '/en' : ''}/blog/${post.slug}`;
const date = new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : 'es-AR', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
}).format(post.data.pubDate);
---

<a class="folder" href={href}>
  <span class="folder-back" aria-hidden="true"></span>
  <span class="folder-tab"><span class="folder-date">{date} · {post.data.readingTime}</span></span>

  <span class="folder-photo" aria-hidden="true">
    {post.data.cover ? <img src={post.data.cover} alt="" loading="lazy" /> : <span class="folder-photo-fallback" />}
  </span>

  <span class="folder-sheet">
    <span class="folder-title">{post.data.title}</span>
    <span class="folder-abstract">{post.data.description}</span>
    <span class="folder-read">{s.readMore} <span aria-hidden="true">→</span></span>
  </span>
</a>

<style>
  .folder {
    --back: #efd9a0;
    --front: #fff3cc;
    --edge: #a98f5a;
    --paper: #fbf7ec;
    --txt: #2e2a24;
    --txt-soft: #4a3828;
    --accent: #573a3e;
    --photo: var(--sky);
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding-top: 34px;
    color: var(--txt);
    text-decoration: none;
  }

  :global(:root[data-theme='dark']) .folder {
    --back: #5c4b38;
    --front: #6e5b44;
    --edge: #2c2218;
    --paper: #eee6d3;
    --txt: #f6f1e4;
    --txt-soft: #ddd3bf;
    --accent: #f1dcb4;
    --photo: #67807f;
  }

  /* Hoja trasera de la carpeta (sombra dura, sin transparencias) */
  .folder-back {
    position: absolute;
    inset: 34px 0 0 0;
    background-color: var(--back);
    background-image: url('/textures/papel.jpg');
    background-size: cover;
    background-position: center;
    background-blend-mode: multiply;
    border-radius: 4px 12px 12px 12px;
    box-shadow: 0 7px 0 var(--edge);
  }

  /* Pestaña con la fecha */
  .folder-tab {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    height: 36px;
    padding: 4px 30px 0 16px;
    background-color: var(--back);
    background-image: url('/textures/papel.jpg');
    background-size: cover;
    background-position: center;
    background-blend-mode: multiply;
    clip-path: polygon(0 100%, 0 14%, 3% 0, calc(100% - 22px) 0, 100% 100%);
  }
  .folder-date {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--txt-soft);
    white-space: nowrap;
  }

  /* Foto que asoma entre la hoja trasera y el frente */
  .folder-photo {
    position: relative;
    z-index: 1;
    display: block;
    margin: 22px 20px -46px;
    aspect-ratio: 5 / 3.4;
    border: 7px solid var(--paper);
    border-radius: 2px;
    overflow: hidden;
    transform: rotate(-1.6deg);
    box-shadow: 0 4px 0 var(--edge);
    transition: transform 0.35s var(--ease);
  }
  .folder-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .folder-photo-fallback {
    display: block;
    width: 100%;
    height: 100%;
    background-color: var(--photo);
  }

  /* Frente de la carpeta */
  .folder-sheet {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-8) var(--space-6) var(--space-6);
    background-color: var(--front);
    background-image: url('/textures/papel.jpg');
    background-size: cover;
    background-position: center;
    background-blend-mode: multiply;
    border-top: 2px solid var(--edge);
    border-radius: 3px 3px 12px 12px;
    box-shadow: 0 7px 0 var(--edge);
    transition: transform 0.35s var(--ease);
  }

  .folder-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1.22;
    color: var(--txt);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .folder-abstract {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--txt-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .folder-read {
    margin-top: var(--space-2);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--accent);
  }

  /* Al pasar el mouse la carpeta se "abre": la foto sube y el frente baja un poco */
  .folder:hover .folder-photo {
    transform: rotate(-2.6deg) translateY(-16px);
  }
  .folder:hover .folder-sheet {
    transform: translateY(5px);
  }

  @media (prefers-reduced-motion: reduce) {
    .folder-photo,
    .folder-sheet {
      transition: none;
    }
  }
</style>
